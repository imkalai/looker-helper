# Copy to .env and adjust. All settings use the LH_ prefix.

# ---- Database -------------------------------------------------------------
# embedded = PostgreSQL inside the container (Docker image default; data on the /data volume)
# cloudsql = Cloud SQL via the Cloud SQL Python Connector (no proxy needed)
# external = any PostgreSQL URL, e.g. the Cloud SQL Auth Proxy at 127.0.0.1:5432
# LH_DB_MODE=embedded
LH_DB_NAME=looker_helper
# cloudsql / external only:
# LH_DB_USER=looker_helper
# LH_DB_PASSWORD=
# LH_DB_POOL_SIZE=5
# cloudsql only:
# LH_CLOUDSQL_INSTANCE=my-project:europe-west2:looker-helper
# LH_CLOUDSQL_IP_TYPE=private          # private | public | psc
# LH_CLOUDSQL_IAM_AUTH=false           # true = IAM database login (LH_DB_USER = service account without .gserviceaccount.com)
# external only:
# LH_DATABASE_URL=postgresql://looker_helper:password@127.0.0.1:5432/looker_helper

# demo = built-in sample tables (no Google Cloud needed); live = real BigQuery via Application Default Credentials
LH_METADATA_MODE=demo
# Project used to run BigQuery dry runs in live mode (defaults to the session's project)
# LH_GCP_BILLING_PROJECT=my-billing-project

# mock = built-in Cortex stand-in; real = corporate Cortex client (app/services/cortex/real.py)
LH_CORTEX_MODE=mock

# ---- Sign-in ----------------------------------------------------------------
# Behind Google IAP (recommended): verify IAP's signed token on every request.
# LH_IAP_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# Other sign-in proxies: the user's email is read from this header and trusted as-is,
# so make sure only the proxy can reach the app.
LH_AUTH_HEADER=X-Goog-Authenticated-User-Email
# Local development only (docker compose sets it). Never set it in a real deployment:
# every request without a sign-in header would be treated as this user.
# LH_DEV_USER_EMAIL=dev.user@example.com
# Comma-separated admin emails (can edit Cortex settings and shared Looker connections)
LH_ADMIN_EMAILS=

# ---- Access limits ----------------------------------------------------------
# BigQuery projects users may pick (comma-separated). Empty = every project the app's credentials can read.
# LH_BQ_ALLOWED_PROJECTS=acme-analytics,acme-ops
# Looker hosts users may connect to (comma-separated patterns). Empty = any public HTTPS host.
# LH_LOOKER_ALLOWED_HOSTS=*.cloud.looker.com
# Show the API docs at /docs (off by default)
# LH_ENABLE_API_DOCS=false

# Encryption key for stored secrets. If empty, one is generated in <data dir>/secret.key.
# Set it explicitly when using Cloud SQL, so every container (and every redeploy) uses the same key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LH_SECRET_KEY=

# Number of app worker processes in the container (default 1)
# LH_WORKERS=2

# Generation defaults
LH_CURRENCY_FORMAT=gbp
LH_PRICE_PER_TIB_GBP=5.0
LH_PII_ACCESS_GRANT=can_see_pii
LH_DEFAULT_MONTHS=12
LH_LARGE_TABLE_GB=50
# Warn on a package when one dashboard refresh reads more than this
LH_COST_WARN_GB=50
LH_ENABLE_PERIOD_OVER_PERIOD=true
